# Copier vers .env (hors Git) ou définir dans l'hébergeur. Générer le secret : openssl rand -base64 48
DB_URL=jdbc:postgresql://localhost:5432/ODCtest
DB_USERNAME=odc_app
DB_PASSWORD=change-me
JWT_SECRET=change-me-with-at-least-32-random-characters
CORS_ORIGINS=https://academy.mondomaine.com
PUBLIC_URL=https://academy.mondomaine.com
ODC_UPLOAD_DIR=/var/odc/uploads
MEDIA_STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ODC_ADMIN_EMAIL=admin@mondomaine.com
ODC_ADMIN_PASSWORD=change-me-strong
# Notifications e-mail (optionnel)
APP_MAIL_ENABLED=false
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# Connexion Google (optionnel) : ID client OAuth « Application Web » créé sur console.cloud.google.com
GOOGLE_CLIENT_ID=
